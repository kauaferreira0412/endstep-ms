# Copie para .env (mesma pasta do docker-compose.vps.yml) e preencha.

# rede docker do Caddy (ja e o padrao nesta VPS)
ENDSTEP_PROXY_NETWORK=webproxy

# URL publica. sslip.io resolve qualquer subdominio -> 187.127.37.101 sem mexer no DNS.
ENDSTEP_PUBLIC_URL=https://endstep.187-127-37-101.sslip.io

# segredos (gere: openssl rand -hex 48  /  openssl rand -hex 16)
ENDSTEP_DB_PASSWORD=
ENDSTEP_JWT_SECRET=

# identifique-se pro Scryfall (obrigatorio pra nao tomar rate-limit) - sem ": " no valor
ENDSTEP_SCRYFALL_USER_AGENT=endstep/1.0 (kauafrreira23@gmail.com)

# vira ADMIN automaticamente ao se cadastrar com esse e-mail
ENDSTEP_ADMIN_EMAIL=kauafrreira23@gmail.com

# --- armazenamento das artes ---
# local (padrao, usa ./.data/uploads no VPS) ou r2 (Cloudflare, nao gasta disco)
ENDSTEP_STORAGE_TYPE=local
# so preencher se ENDSTEP_STORAGE_TYPE=r2:
# R2_ACCOUNT_ID=f144fc890f5fb6e63f4f27f205ff6489
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=endstep-art
# R2_PUBLIC_BASE_URL=https://pub-1fa29cacb2734ca7b11761a929679a9c.r2.dev

# --- login com Google (opcional; deixe vazio pra desativar) ---
# obs.: o Google costuma recusar OAuth em dominios .sslip.io — precisa de dominio proprio.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- traducao PT-BR das cartas ---
# Scryfall oficial funciona sem chave; a chave abaixo e so pro fallback Google Translate
ENDSTEP_TRANSLATION_ENABLED=true
# GOOGLE_TRANSLATE_API_KEY=
