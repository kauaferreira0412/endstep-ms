# Copie para .env (mesma pasta do docker-compose.vps.yml) e preencha.

# rede docker do Caddy — descubra com:  docker network ls | grep concorde
ENDSTEP_PROXY_NETWORK=concorde_default

# URL publica que voce vai apontar no Caddy (com https)
ENDSTEP_PUBLIC_URL=https://endstep.seudominio.com

# segredos
ENDSTEP_DB_PASSWORD=troque-esta-senha-forte
ENDSTEP_JWT_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres-ou-mais

# identifique-se pro Scryfall (obrigatorio pra nao tomar rate-limit)
ENDSTEP_SCRYFALL_USER_AGENT=endstep/1.0 (contato: kauafrreira23@gmail.com)

# admin automatico ao cadastrar
ENDSTEP_ADMIN_EMAIL=kauafrreira23@gmail.com

# --- opcionais ---
# armazenamento das artes: local (padrao, usa ./.data/uploads) ou r2
ENDSTEP_STORAGE_TYPE=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# login com Google (deixe vazio para desativar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# traducao PT-BR das cartas via Google Translate (Scryfall oficial funciona sem chave)
ENDSTEP_TRANSLATION_ENABLED=true
# GOOGLE_TRANSLATE_API_KEY=
